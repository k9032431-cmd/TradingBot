# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Через запятую — кто может пользоваться ботом (пусто = все). Узнать свой id: /id
ALLOWED_USERS=
# Как часто проверять цены для алертов (секунды)
ALERT_INTERVAL=10
DB_PATH=data/trading.db
# Binance (ключи из account.tiger.com/api): частота синхронизации сделок (сек)
SYNC_INTERVAL=60
# Необязательно: ключ шифрования API-секретов. Если пусто — создастся data/secret.key
ENCRYPTION_KEY=
